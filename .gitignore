# --- generated output (never source; see 3d/CLAUDE.md) ---
3d/out/
3d/d.vtk
3d/tools/_refcache/

# --- ROS 2 colcon workspace ---
ros2/build/
ros2/install/
ros2/log/
ros2/pixi/.pixi/          # the conda env itself: ~2.3 GB, rebuilt by `pixi install`

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- macOS ---
.DS_Store

# --- OrcaSlicer CLI logs into the CWD (tools/slice_orca.py) ---
3d/*.log

# --- terrain seed sweep ---
# MuJoCo caches a heightfield by file name inside a process, so sweeping seeds
# writes one scene + one png per seed.  Scratch: the committed terrain is
# terrain.png / scene_terrain.xml at terrain.SEED.
ros2/smalldog_description/mujoco/sweep_terrain_*.xml
ros2/smalldog_description/meshes/sweep_terrain_*.png

# --- RL ---
# runs/ is checkpoints and rollout video; uv.lock is deliberately NOT here,
# a pinned resolution is the point when three machines share one tree.
rl/runs/
rl/.venv/
# XLA's compiled executables and its per-fusion autotuning, keyed on the HLO and
# the jax/jaxlib versions.  Machine-local by construction, and disposable: see
# rl/jaxenv.py, which has the rm and why there is no size cap.
rl/.jax_cache/

# --- bench ---
# raw servo logs: hundreds of MB, and the fit's output (rl/params/st3215.json)
# is the thing worth versioning, not its input.
robot/bench/data/

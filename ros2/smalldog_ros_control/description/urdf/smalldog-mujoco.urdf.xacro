<?xml version="1.0"?>
<!-- SmallDog: MuJoCo-backed ros2_control system -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smalldog">

  <xacro:include filename="$(find smalldog_description)/urdf/smalldog.urdf" />

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
    </hardware>

    <xacro:macro name="pid_joint" params="name">
      <joint name="${name}">
        <param name="position_kp">120</param>
        <param name="position_ki">0</param>
        <param name="position_kd">3</param>
        <param name="position_i_max">10</param>
        <command_interface name="position_pid"/>
        <state_interface name="position">
          <param name="initial_value">0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

   <xacro:pid_joint name="fl_roll" />
   <xacro:pid_joint name="fl_pitch" />
   <xacro:pid_joint name="fl_knee" />
   <xacro:pid_joint name="fr_roll" />
   <xacro:pid_joint name="fr_pitch" />
   <xacro:pid_joint name="fr_knee" />
   <xacro:pid_joint name="rl_roll" />
   <xacro:pid_joint name="rl_pitch" />
   <xacro:pid_joint name="rl_knee" />
   <xacro:pid_joint name="rr_roll" />
   <xacro:pid_joint name="rr_pitch" />
   <xacro:pid_joint name="rr_knee" />

  </ros2_control>
</robot>

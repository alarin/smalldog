<?xml version="1.0"?>
<!-- SmallDog: MuJoCo-backed ros2_control system -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smalldog">

  <xacro:include filename="$(find smalldog_description)/urdf/smalldog.urdf" />

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
    </hardware>

    <xacro:macro name="pid_joint" params="name">
      <joint name="${name}">
        <param name="position_kp">120</param>
        <param name="position_ki">0</param>
        <param name="position_kd">3</param>
        <param name="position_i_max">10</param>
        <command_interface name="position_pid"/>
        <state_interface name="position">
          <param name="initial_value">0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

   <xacro:pid_joint name="fl_roll" />
   <xacro:pid_joint name="fl_pitch" />
   <xacro:pid_joint name="fl_knee" />
   <xacro:pid_joint name="fr_roll" />
   <xacro:pid_joint name="fr_pitch" />
   <xacro:pid_joint name="fr_knee" />
   <xacro:pid_joint name="rl_roll" />
   <xacro:pid_joint name="rl_pitch" />
   <xacro:pid_joint name="rl_knee" />
   <xacro:pid_joint name="rr_roll" />
   <xacro:pid_joint name="rr_pitch" />
   <xacro:pid_joint name="rr_knee" />

    <!-- Body IMU.  mujoco_ros2_control keys off the name: it strips everything after the
         last underscore and looks for MuJoCo sensors <prefix>_quat / _gyro / _accel, and
         it only treats the sensor as an IMU at all if the name contains "_imu".  So
         "imu_imu" is not a typo - prefix "imu", kind "imu" - and it matches the sensors
         generate_model.py writes into mujoco/robot.xml.  Publishing it needs
         imu_sensor_broadcaster; without that package the walker just runs open loop. -->
    <sensor name="imu_imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>

  </ros2_control>
</robot>
